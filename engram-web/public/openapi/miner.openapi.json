  "components": {
    "schemas": {
      "SignedMinerRequest": {
        "type": "object",
        "description": "sr25519 signed request body used by miner auth. Canonical message: \"{nonce}:{endpoint}:{sha256(payload)}\".",
        "properties": {
          "hotkey": {
            "type": "string",
            "description": "SS58 address of the signing hotkey"
          },
          "nonce": {
            "type": "integer",
            "format": "int64",
            "description": "Unix ms nonce for replay protection"
          },
          "signature": {
            "type": "string",
            "description": "Hex sr25519 signature over the canonical message"
          }
        },
        "required": [
          "hotkey",
          "nonce",
          "signature"
        ],
        "additionalProperties": true
      },
      "NamespaceOwnershipRequest": {
        "type": "object",
        "description": "Ownership proof for namespace-scoped read/write operations.",
        "properties": {
          "namespace": {
            "type": "string"
          },
          "namespace_hotkey": {
            "type": "string"
          },
          "namespace_sig": {
            "type": "string"
          },
          "namespace_timestamp_ms": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "namespace",
          "namespace_hotkey",
          "namespace_sig",
          "namespace_timestamp_ms"
        ],
        "additionalProperties": true
      },
      "NamespaceAttestationRequest": {
        "type": "object",
        "properties": {
          "namespace": {
            "type": "string"
          },
          "owner_hotkey": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          },
          "timestamp_ms": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "namespace",
          "owner_hotkey",
          "signature",
          "timestamp_ms"
        ],
        "additionalProperties": true
      },
      "NamespaceActionRequest": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "create",
              "delete",
              "rotate",
              "list"
            ]
          },
          "namespace": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "new_key": {
            "type": "string"
          }
        },
        "required": [
          "action",
          "namespace"
        ],
        "additionalProperties": true
      },
      "NamespaceKeyShareStoreRequest": {
        "type": "object",
        "properties": {
          "namespace": {
            "type": "string"
          },
          "namespace_hotkey": {
            "type": "string"
          },
          "namespace_sig": {
            "type": "string"
          },
          "namespace_timestamp_ms": {
            "type": "integer",
            "format": "int64"
          },
          "share_index": {
            "type": "integer"
          },
          "share_hex": {
            "type": "string"
          },
          "threshold": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        },
        "required": [
          "namespace",
          "namespace_hotkey",
          "namespace_sig",
          "namespace_timestamp_ms",
          "share_index",
          "share_hex",
          "threshold",
          "total"
        ],
        "additionalProperties": true
      },
      "ChatHistoryRequest": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "conv_id": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "user_id"
        ],
        "additionalProperties": true
      },
      "ConversationCreateRequest": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "conv_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "conv_id"
        ],
        "additionalProperties": true
      },
      "ConversationRenameRequest": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "title"
        ],
        "additionalProperties": true
      },
      "ListMemoriesRequest": {
        "type": "object",
        "properties": {
          "filter": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "namespace": {
            "type": "string"
          },
          "namespace_hotkey": {
            "type": "string"
          },
          "namespace_sig": {
            "type": "string"
          },
          "namespace_timestamp_ms": {
            "type": "integer",
            "format": "int64"
          }
        },
        "additionalProperties": true
      },
      "ProveMemoryRequest": {
        "type": "object",
        "properties": {
          "cid": {
            "type": "string"
          },
          "embedding_hash": {
            "type": "string"
          }
        },
        "required": [
          "cid",
          "embedding_hash"
        ],
        "additionalProperties": false
      }
    }
  }
